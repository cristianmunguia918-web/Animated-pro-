body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #0f172a;
    color: #f8fafc;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}
.container {
    text-align: center;
    background: #1e293b;
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: 0 10px 25px rgba(0,0,0,0.3);
}
h1 { margin-bottom: 1rem; font-size: 1.8rem; }
#timer { font-size: 4rem; font-weight: bold; margin: 1.5rem 0; color: #38bdf8; }
.buttons button {
    background: #38bdf8;
    color: #0f172a;
    border: none;
    padding: 0.6rem 1.2rem;
    margin: 0.3rem;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.2s;
}
.buttons button:hover { background: #0ea5e9; }
